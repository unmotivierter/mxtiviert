{
  "name": "Flutter (Codespaces)",
  "build": { "dockerfile": "Dockerfile" },
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ]
    }
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Flutter Web", "onAutoForward": "openBrowser" }
  },
  "remoteUser": "vscode"
}